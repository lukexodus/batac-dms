{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import @opentelemetry/instrumentation/hook.mjs --import ./src/instrumentation.ts src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx src/database/seeds/orchestrator.ts",
    "test": "vitest run",
    "format": "prettier --write --config ../../packages/config/.prettierrc.json --ignore-path ../../packages/config/.prettierignore --ignore-unknown ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@batac/database": "workspace:*",
    "@batac/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@opentelemetry/instrumentation-fastify": "^0.57.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/instrumentation-pino": "^0.66.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@trpc/server": "^11.18.0",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.43.0",
    "dompurify": "^3.4.13",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "5.1.0",
    "jsdom": "^30.0.1",
    "json-logic-js": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "3.3.15",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^10.0.0",
    "pino": "^9.0.0",
    "pino-opentelemetry-transport": "^1.1.0",
    "postgres": "^3.4.4",
    "qrcode": "^1.5.4",
    "scribe.js-ocr": "^0.14.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@batac/config": "workspace:^",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^28.0.3",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
