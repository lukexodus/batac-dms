    "@batac/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.2.2",
    "@trpc/server": "^11.18.0",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.43.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "json-logic-js": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^10.0.0",
    "pino": "^9.0.0",
