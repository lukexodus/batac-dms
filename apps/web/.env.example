# apps/web/.env.example
VITE_API_URL=http://localhost:3000

# ─── OpenTelemetry RUM ─────────────────────────────────────────────────
# Obtain a dedicated RUM ingestion token from the OpenObserve UI's
# "Ingestion" page, or via POST /api/:org_id/rumtoken — do NOT use the
# admin/root login credential here. The value below is a local-dev
# placeholder only.
VITE_OTEL_RUM_CLIENT_TOKEN=dev-placeholder-replace-with-real-rum-token
VITE_OTEL_RUM_SITE=localhost:5080
VITE_OTEL_RUM_ORGANIZATION=default
